# PostgreSQL 数据库配置
DB_HOST=postgres          # 数据库主机地址
DB_PORT=5432              # 数据库端口
DB_USER=bise              # 数据库用户名
DB_PASSWORD=change-me     # 数据库密码（请修改）
DB_NAME=bise              # 数据库名称

# PostgreSQL 对外暴露端口
PG_EXPOSE_PORT=54322      # 本地访问数据库的映射端口

# Redis 缓存配置
REDISHOST=redis           # Redis 主机地址
REDISPORT=6379            # Redis 端口
REDISPASSWORD=            # Redis 密码（如无需密码请留空）

# Redis 对外暴露端口
REDIS_EXPOSE_PORT=63790   # 本地访问 Redis 的映射端口

# JWT 密钥配置
JWT_SECRET_KEY=change-me           # JWT 访问令牌密钥（请修改）
JWT_REFRESH_SECRET_KEY=change-me   # JWT 刷新令牌密钥（请修改）

# FastAPI 服务配置
FASTAPI_HOST=0.0.0.0     # 服务监听地址
FASTAPI_PORT=8000        # 服务端口
FASTAPI_WORKERS=1        # 工作进程数
FASTAPI_RELOAD=1         # 是否开启热重载（开发环境可设为1）

# 日志配置
SUPERVISOR_LOG_MODE=stdout  # 日志输出模式

# CORS 配置
BACKEND_CORS_ORIGINS=["https://example.com"]  # 允许的跨域来源列表
